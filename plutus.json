              "$ref": "#/definitions/Int"
            },
            {
              "title": "daily",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "guard/types/GuardDatum": {
      "title": "GuardDatum",
      "description": "Mutable guard state (inline datum on the singleton guard UTxO). v2 pinnable +\n per-asset caps: `owner` and `stt_policy` in the datum for hash-only client\n attestation; `token_caps` declares the tradeable-token set + quantity limits.\n Only `spends` changes on the agent branch — every other field is an\n owner-controlled invariant.",
      "anyOf": [
        {
          "title": "GuardDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "owner",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
