    "guard/types/AssetCap": {
      "title": "AssetCap",
      "description": "Owner-declared per-token cap (QUANTITY, not value — no oracle). The agent may\n move at most `per_tx` of this token out in one tx and `daily` over the sliding\n `window_len`. Immutable to the agent (datum-invariance).",
