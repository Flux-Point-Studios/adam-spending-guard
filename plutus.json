    "guard/types/GuardDatum": {
      "title": "GuardDatum",
      "description": "Mutable guard state, carried as the inline datum on the singleton guard UTxO.\n\n Config fields (agent, caps, window_len, min_principal, max_spends, expiry,\n kill) are OWNER-controlled invariants: the agent branch must forward them\n unchanged. Only `spends` may change on the agent branch, and only by pruning\n aged-out records and prepending the current one per the sliding-window rule.",
      "anyOf": [
        {
          "title": "GuardDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "agent",
              "description": "Server session key hash — the bounded (agent) authority.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "per_tx_cap",
              "description": "Max net ADA (lovelace) outflow the guard may lose in a single agent tx.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "daily_cap",
              "description": "Max cumulative net ADA outflow over ANY trailing `window_len` interval.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "window_len",
              "description": "Sliding window length in POSIX ms (e.g. 86_400_000 = 24h).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "spends",
              "description": "Active outflow records within the current window (state). Newest first.",
              "$ref": "#/definitions/List<guard~1types~1SpendRecord>"
            },
            {
              "title": "min_principal",
              "description": "The guard's continuing output must keep at least this much ADA; below it\n the agent branch is disabled (a defined, owner-sweepable state).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "max_spends",
              "description": "Upper bound on the active record list — caps datum growth and rate-limits\n by count as well as value.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "expiry",
              "description": "POSIX ms hard session expiry; after this only the owner branch spends.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "kill",
              "description": "Owner-flipped kill switch; True disables the agent branch entirely.",
              "$ref": "#/definitions/Bool"
            }
          ]
        }
      ]
    },
    "guard/types/GuardRedeemer": {
      "title": "GuardRedeemer",
      "anyOf": [
