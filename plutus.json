            },
            {
              "title": "agent",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "per_tx_cap",
              "description": "ADA (lovelace) caps + the shared sliding window (ms).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "daily_cap",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "window_len",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "token_caps",
              "description": "Declared tradeable tokens the agent may SELL, each quantity-capped. Tokens\n NOT listed here can be acquired but never leave the guard on the agent branch.",
              "$ref": "#/definitions/List<guard~1types~1AssetCap>"
            },
            {
              "title": "spends",
